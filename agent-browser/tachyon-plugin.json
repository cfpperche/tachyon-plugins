{
  "name": "agent-browser",
  "version": "3.2.0",
  "description": "Give an agent eyes + hands on the web through pinned agent-browser 0.34.0: inspect pages, take screenshots, extract content, and drive forms. confirmActions matches exact protocol names: shipped upload/download hold; eval does not because its protocol name is evaluate. Keeping eval is an explicit owner decision dated 2026-08-21. Get human approval before every write. allowedDomains is a human-owned global workspace mode that agents cannot widen. In 0.34 it cannot coexist with state load, --state, or --restore: saved state can replay origins before the allowlist verifies them. Default to allowedDomains; switching to saved-state auth requires the human to remove it in Plugins → Config, which removes the host boundary for every invocation using that config. Needs host Chrome/Chromium.",
  "runtimes": [
    "claude",
    "codex",
    "grok"
  ],
  "config": {
    "file": "config/agent-browser.json",
    "schemaFile": "config/schema.json"
  },
  "docsUrl": "https://github.com/cfpperche/tachyon-plugins/tree/main/agent-browser",
  "tools": {
    "agent-browser": {
      "version": "0.34.0",
      "launchPolicy": {
        "configArg": "--config",
        "scrubEnv": [
          "AGENT_BROWSER_CONFIRM_ACTIONS",
          "AGENT_BROWSER_ACTION_POLICY",
          "AGENT_BROWSER_CONFIG",
          "AGENT_BROWSER_INIT_SCRIPTS",
          "AGENT_BROWSER_EXTENSIONS",
          "AGENT_BROWSER_PLUGINS",
          "AGENT_BROWSER_CDP",
          "AGENT_BROWSER_AUTO_CONNECT",
          "AGENT_BROWSER_ARGS",
          "AGENT_BROWSER_ALLOWED_DOMAINS"
        ],
        "denyArgs": [
          "--confirm-actions",
          "--action-policy",
          "--allowed-domains",
          "--config",
          "--init-script",
          "--extension",
          "--cdp",
          "--auto-connect",
          "--args",
          "addinitscript",
          "connect",
          "mcp",
          "batch"
        ],
        "mode": "force"
      },
      "platforms": {
        "linux-x64-glibc": {
          "url": "https://github.com/vercel-labs/agent-browser/releases/download/v0.34.0/agent-browser-linux-x64",
          "sha256": "69eadf5d8d6003a06a5cd2f914ebb261c7754fe1335a9190122c334e91909789"
        },
        "linux-x64-musl": {
